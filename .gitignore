# -----------------------------
# ExpenseGuard .gitignore
# -----------------------------

# OS / Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.*
*.env
secrets.json
*.pem
*.key
*.crt
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
.eggs/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/

# Build / cache
build/
dist/
.cache/
tmp/
temp/

# Data artifacts (keep repository lightweight)
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# ML artifacts
*.parquet
*.feather
*.pkl
*.joblib
*.onnx

# Docker
*.pid
*.seed
*.pid.lock
